# AWS Elastic Beanstalk Production Environment
# Set these as Environment Variables in EB Console

# Database Configuration (Neon Database)
DATABASE_URL=postgresql://neondb_owner:npg_O6P5wsmlIjHc@ep-raspy-mouse-adpwqb3e-pooler.c-2.us-east-1.aws.neon.tech/ddc_db?sslmode=require&channel_binding=require

# Application Settings
NODE_ENV=production
PORT=8080

# Security (Generate a secure random string for production)
SESSION_SECRET=eb-production-secure-session-secret-change-this-to-random-256-bit-key

# Application Features
DISABLE_DB_SEEDING=false

# AWS Configuration
AWS_REGION=us-east-1

# Logging and Monitoring
LOG_LEVEL=info
ENABLE_ACCESS_LOGS=true

# Performance
NODE_OPTIONS=--max-old-space-size=1024