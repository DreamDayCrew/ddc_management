# Files and directories to ignore during EB deployment
node_modules
.git
.gitignore
*.md
.env
.env.local
.env.development
.vscode
.idea
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test files
__tests__
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# Development files
src/
client/src/
*.ts
*.tsx
tsconfig.json
vite.config.ts
tailwind.config.ts
postcss.config.js

# Keep only production files
!dist/
!package.json
!package-lock.json
!.ebextensions/
!server/
!shared/
!drizzle.config.ts