# Production Environment Variables for AWS Amplify
# These will be set in Amplify Console Environment Variables

# Database Configuration
DATABASE_URL=postgresql://neondb_owner:npg_O6P5wsmlIjHc@ep-raspy-mouse-adpwqb3e-pooler.c-2.us-east-1.aws.neon.tech/ddc_db?sslmode=require&channel_binding=require

# Application Settings
NODE_ENV=production
PORT=3000

# Security
SESSION_SECRET=amplify-production-secret-key-change-this-to-secure-random-string

# Features
DISABLE_DB_SEEDING=true

# AWS Specific
AWS_REGION=us-east-1

# Optional: Logging
LOG_LEVEL=info
ENABLE_ACCESS_LOGS=true